# ==============================================================================
# AegisSOC AI — Environment Configuration Template
# DO NOT commit actual secrets or production credentials to source control.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AegisSOC AI"
DEBUG=true

# Security & Cryptography
# Generate a strong 256-bit key in production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (Comma-separated list of allowed origins)
# In production, specify exact origins. NEVER use "*" in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegissoc_user
POSTGRES_PASSWORD=aegissoc_secure_password
POSTGRES_DB=aegissoc_db
# Set DATABASE_URL directly if using a full connection string
# DATABASE_URL=postgresql+asyncpg://aegissoc_user:aegissoc_secure_password@localhost:5432/aegissoc_db

# Redis Cache / Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
