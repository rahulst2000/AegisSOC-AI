# ==============================================================================
# AegisSOC AI — Backend Environment Configuration Template
# DO NOT commit actual secrets or production credentials to source control.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AegisSOC AI"
DEBUG=true

# Security & Cryptography
SECRET_KEY=change-this-in-production-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegissoc_user
POSTGRES_PASSWORD=aegissoc_secure_password
POSTGRES_DB=aegissoc_db

# Redis Cache / Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI & Google Gemini Configuration
# The actual API key must NEVER be committed to Git.
# Provide via environment variable: GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=4096
